# ============================================
# 扫雷大冒险 · .gitignore
# 当前项目是零依赖的单文件网页游戏，
# 以下规则主要用来挡掉系统、编辑器和本地临时文件。
# ============================================

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 依赖与构建 ----------
# 目前无需安装依赖或构建，以下为后续扩展预留
node_modules/
dist/
build/
coverage/
.cache/

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp

# ---------- 本地环境变量 ----------
.env
.env.local
.env.*.local
